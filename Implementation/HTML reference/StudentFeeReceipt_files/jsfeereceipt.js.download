var finepflag = true;
$(document).ready(function () {
    GetPermissions();
    $("#divfees").html('');
    fillStudentFees();
});
function fillStudentFees() {
    showProcessDialog("divprocess", true);
    setTimeout(function () {
        try {
            var response = Feepayments_studentfeereceipt.FillStudentFees();
            if (response.error == null) {
                $("#divfees").html(response.value);
                //$("#divtabs").tabs({ collapsible: true, active: false, clearStyle: true, autoHeight: true });
                $("#divtabs").tabs();
                /*$("#divtabs").tabs({
                    select: function (event, ui)
                    {
                        alert("dd");
                        ResizeIFrame();
                    }
                });*/
            }
            else
                alert(response.error);
        }
        catch (e) {
            alert(e.error);
        }
        showProcessDialog("divprocess", false);
        IncreaseIFrameHeight(2000);
    }, 500);
}
function calculateAmounts() {

    if ($("#divtabs").tabs("length") > 0) {
        $("#trexcess").hide();
        $("#spnexcess").text("0");
        var _total = 0, _totalfine = 0, _totalfinepaying = 0, _totalfeepaying = 0;
        var _givenamount = parseFloat($("#txtgivenamount").val());

        var _flag = true;
        var i = 0;
        //for (var i = 0; i < $("#divtabs").tabs("length"); i++) {
        $("#divtabs").find("table").each(function () {
            $(this).find("input:checkbox").each(function () {
                var _row = $(this).parent().parent();
                var _balanceamount = parseFloat(_row.find("label[name=lblbalance]").text());
                if (_flag && _balanceamount > 0) {

                    var _txtbox = _row.find("input:text[name=txtamount]");
                    var _txtfine = _row.find("input:text[name=txtfine]");
                    _txtfine.val('');
                    var _feeamount = _balanceamount;
                    var _fineamount = 0;
                    if (_flag) {
                        var _txtfinep = _row.find("input:text[name=txtfinep]");
                        if (_txtfinep.val() != '') {
                            _fineamount = (parseFloat(_txtfinep.val()) / 100) * _balanceamount;
                        }
                    }
                    _txtfine.val(Math.round(parseFloat(_fineamount)).toFixed(2));
                    var _paidfine = 0;
                    _feeamount = _balanceamount;
                    if (_givenamount >= (_feeamount + _fineamount)) {
                        _feeamount = _feeamount + _fineamount;
                        _paidfine = _fineamount;
                        _totalfeepaying += _balanceamount;
                    }
                    else {

                        if (_fineamount > 0) {
                            if (_feeamount < _givenamount) {
                                _paidfine = _givenamount - _feeamount;
                            }
                        }

                        _feeamount = _givenamount;
                        _totalfeepaying += _feeamount;
                    }

                    _txtbox.val(_feeamount.toFixed(2));
                    _txtfine.attr("title", _paidfine.toFixed(2));
                    _totalfinepaying += _paidfine;
                    _total += _feeamount;
                    _totalfine += _fineamount;
                    _givenamount -= _feeamount;
                    if (_feeamount <= 0)
                        $(this).attr("checked", false).attr("disabled", true);
                    else
                        $(this).attr("checked", true);
                    if (_givenamount <= 0)
                        _flag = false;
                }
            });

        });
        $("#spntotal").text(_total.toFixed(2));
        $("#spnfine").text(_totalfine.toFixed(2));
        $("#spnfeepaying").text(_totalfeepaying.toFixed(2));
        $("#spnfinepaying").text(_totalfinepaying.toFixed(2));
        var _excess = parseFloat($("#txtgivenamount").val()) - _total;
        if (_excess) {
            $("#spnexcess").text(_excess.toFixed(2));
            $("#trexcess").show();
        }
    }
}
function onFinePercentBlur(o) {
    var _row = $(o).parent().parent();
    var _balanceamount = $(o).val();
    var _txtbox = $(o);
    var _txtfinep = _row.find("input:text[name=txtfinep]");
    var _txtfine = _row.find("input:text[name=txtfine]");
    checkFinePercent(_row, _txtfinep.val(), _txtfinep);
    if (finepflag) {
        //if (_txtfine.val() == "" || parseFloat(_txtfine.val()) == 0) {  //temporary condition   31-mar-2022
        if (_balanceamount != "" && $(_txtfinep).val() != "" && parseFloat(_txtfinep.val()) > 0) {
            var _fineamount = 0;
            _fineamount = Math.round((parseFloat(_txtfinep.val()) / 100) * _balanceamount);
            _txtfine.val(parseFloat(_fineamount)); //.toFixed(2));
            $(_txtfine).attr("title", _fineamount);
        }
        else {
            /*$(o).attr("title", "0");
            $(o).val("0");
            $(_txtbox).val(_balanceamount);*/

        }
        //}
    }
    calculateTotal();
    //adjustExcessPaid();
}
function onFeeCheckBoxClick(o) {
    var _row = $(o).parent().parent();
    var _txtamount = _row.find("input:text[name=txtamount]");
    var _txtfine = _row.find("input:text[name=txtfine]");
    _txtamount.val('');
    _row.find("input:text").attr("disabled", !$(o).attr("checked"));
    var _txtfinep = _row.find("input:text[name=txtfinep]");
    _txtfinep.attr("disabled", true)
    _txtfine.attr("disabled", true);
    if ($(o).attr("checked")) {
        _txtamount.val(_row.find("label[name=lblbalance]").text());
        checkFinePercent(_row, _txtfinep.val(), _txtfine);
        if (finepflag) {
            if (_txtfine.val() == "" || parseFloat(_txtfine.val()) == 0)
                onFinePercentBlur(_txtamount);
        }
        _txtamount.focus();

    }
    calculateTotal();
    //adjustExcessPaid();
}

function calculateTotal() {
    if ($("#divtabs").find("table").length > 0) {
        $("#trexcess").hide();
        $("#spnexcess").text("0");
        $("#spntotal").text("0");
        var _total = 0, _totalfine = 0;
        var _flag = true;
        $("#divtabs").find("table").each(function () {
            $(this).find("input:checkbox:checked").each(function () {
                if (_flag) {
                    var _row = $(this).parent().parent();
                    var _txtbox = _row.find("input:text[name=txtamount]");
                    if (_txtbox.val() != '') {
                        _flag = checkNumeric(_txtbox, "amount", true);
                        if (_flag)
                            _total += parseFloat(_txtbox.val());
                    }
                    var _tbfine = _row.find("input:text[name=txtfine]");
                    if (_tbfine.val() != '')
                        _totalfine += parseFloat(_tbfine.val());
                }
            });
        });
        if (_flag) {
            if ($("#chk_misc_fee").length > 0 && $("#chk_misc_fee").attr("checked")) {
                _total += parseFloat($("#hdn_misc_fee").val());
            }
            $("#spnfeepaying").text(_total.toFixed(2));
            //$("#spntotal").text(_total.toFixed(2));
            //$("#spnfinepaying").text(_totalfine.toFixed(2));
            $("#spnfine").text(_totalfine.toFixed(2));
            //$("#spnfeepaying").text(_total.toFixed(2));
            var _fineconc = 0;
            $("#spntotal").text((_total + (_totalfine - _fineconc)).toFixed(2));
            var _excess = parseFloat($("#txtgivenamount").val()) - _total;
            if (_excess > 0) {
                $("#spnexcess").text(_excess.toFixed(2));
                $("#trexcess").show();
            }
        }
    }
}

function adjustExcessPaid() {
    var _excesspaid = parseFloat($("#spnexcess").text());
    if (_excesspaid > 0) {
        $("#divtabs").find("table").each(function () {
            $(this).find("input:checkbox:checked").each(function () {
                if (_excesspaid > 0) {
                    var _row = $(o).parent().parent();
                    var _balanceamount = parseFloat(_row.find("label[name=lblbalance]").text());
                    var _row = $(this).parent().parent();
                    var _txtbox = _row.find("input:text[name=txtamount]");
                    var _txtfine = _row.find("input:text[name=txtfine]");
                    var _tobepaid = (_balanceamount + parseFloat($(_txtfine).val()));
                    var _paying = parseFloat($(_txtbox).val());
                    if (_paying < _tobepaid) {
                        if ((_paying + _excesspaid) <= _tobepaid) {
                            $(_txtbox).val((_paying + _excesspaid));
                        }
                        else {
                            $(_txtbox).val((_tobepaid));
                        }
                    }


                }
            });
        });
        calculateTotal();
    }
}
function onReceiptSaveClick() {
    var _flag = true;
    var _groupid = -1;
    if (finepflag) {
        if (_flag) {
            var _arrfeedueslno = [];
            var _arramount = [];
            var _arrfine = [];
            var _arrrevenueid = [];
            var _arrsemesterid = [];
            var _arrencdata = [];
            var _arrencfinedata = [];
            var _arrencfinep = [];
            try {
                var _paidyearcheck = true;
                var _prevtabstatus = true;
                var _index = 1;
                /*Old Code*/
                //new code
                var arrsembalance = [];
                var arrsempaid = [];
                $("#divtabs").find("table").each(function () {
                    var _semtable = $(this);
                    var _amount = "";
                    var sembalance = 0, sempaid = 0
                    $(_semtable).find("label[name=lblbalance]").each(function () {
                        _amount = $(this).text();
                        if (_amount != "" && !isNaN(_amount)) {
