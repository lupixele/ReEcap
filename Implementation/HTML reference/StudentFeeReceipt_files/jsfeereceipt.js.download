    else alert("Can't modify fine");
}
function onFineCalculate(o) {
    //var _row = $(o).parent().parent();
    //var _txtfine = null;  //$(_row).find("input:text[name=txtfine]");
    //$(_txtfine).val('');
    try {
        /*var _finepercent = $(_row).find("input:text[name=txtfinep]").val();
        if (_finepercent != '' && parseFloat(_finepercent) > 0) {
            $(_txtfine).val((_finepercent / 100) * parseFloat($(o).val()));
        }
        $(_txtfine).attr("title", ($(_txtfine).val()==""?"0":$(_txtfine).val()));*/
        var _totalfine = 0, _totalamount = 0;
        $("#divtabs").find("table").each(function () {
            $(this).find("input:checkbox:checked").each(function () {
                _row = $(this).parent().parent();
                var _txtfine = $(_row).find("input:text[name=txtfine]");
                var _txtfinep = $(_row).find("input:text[name=txtfinep]");
                var _finepercent = _txtfinep.val();
                var _feeamount = $(_row).find("input:text[name=txtamount]").val();
                checkFinePercent(_row, _finepercent, _txtfinep);
                if (finepflag) {
                    if (_feeamount != '' && _finepercent != '' && parseFloat(_finepercent) > 0) {
                        var _headfine = Math.round((parseFloat(_finepercent) / 100) * parseFloat(_feeamount));
                        $(_txtfine).val(_headfine);
                    }
                }
                var _fineamount = $(_txtfine).val();
                if (_fineamount != "")
                    _totalfine += parseFloat(_fineamount);
                if (_feeamount != '')
                    _totalamount += parseFloat(_feeamount);
                $(_txtfine).attr("title", (_fineamount == "" ? "0" : _fineamount));

            });
        });
        $("#spnfinepaying").text(_totalfine.toFixed(2));
        $("#spnfeepaying").text(_totalamount.toFixed(2));
        var _gtotal = _totalfine + _totalamount;
        $("#spntotal").text(_gtotal.toFixed(2));
    }
    catch (e) { alert(e.error); }
}
function checkFinePercent(tblrow, finep, ctlfinep) {
    try {
        //alert($(tblrow).find("input:hidden[name=hdnfinep]").val()+","+ finep);
        var fineresponse = Feepayments_studentfeereceipt.CheckFeeFinePercent($(tblrow).find("input:hidden[name=hdnfinep]").val(), finep);
        if (fineresponse.error == null) {
            if (finepflag)
                finepflag = fineresponse.value;
        }
        else console.log(fineresponse.error);
    }
    catch (e) {
        alert(e.error);
    }
}