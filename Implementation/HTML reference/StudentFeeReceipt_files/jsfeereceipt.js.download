                            //alert($("#tdrollno").text() + "," + $("#tddate").text() + "," + _paymode + "," + $("#ddlbank").val() + "," + _ddno + "," + _branch + "," + $("#txtdddate").val() + "," + _groupid + "," + $("#txtreceiptno").val() + "," + _arrfeeid[0] + "," + _arramount[0] + "," + _arrfine[0] + "," + _arrrevenueid[0] + "," + _arryearid[0] + "," + _arrsemester[0] + "," + $("#txtnarration").val() + "," + $("#spnexcess").text() + "," + _arrgroupid[0] + "," + $("#tdstudentname").text() + "," + $("#tdparentname").text() + "," + $("#tdparentmobile").text());
                            var paythrough = $("input:radio[name=radpayfrom]:checked").val();
                            var response = Feepayments_studentfeereceipt.SaveFeeReceipt($("#tdrollno").attr("name"), _arrfeedueslno, _arramount, _arrfine, _arrrevenueid, _arrsemesterid, miscmount, _arrencdata, _arrencfinedata, _arrencfinep, paythrough, $("#spnmobile").text());
                            if (response.error == null) {
                                if (response.value == "") {
                                    $("#divfees").html('');

                                    if (paythrough == 'P')
                                        window.open("../sbireturnurl.aspx", "OPayment", 'width=800,height=500,toolbar=no,scrollbars=yes,titlebar=no,status=no,directories=no,location=no');
                                    else window.open("../bankrequesticici.aspx", "OPayment", 'width=800,height=500,toolbar=no,scrollbars=yes,titlebar=no,status=no,directories=no,location=no');
                                }
                                else {
                                    alert(response.value);
                                }
                            }
                            else
                                alert(response.error);
                        }
                        catch (e) {
                            alert(e.error);
                        }
                        showProcessDialog("divprocess", false);
                        ResizeIFrame();
                    }, 500);
                }
            }
        }
