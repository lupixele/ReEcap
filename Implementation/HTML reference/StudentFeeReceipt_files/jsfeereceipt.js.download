                    _arramount.push("0");
                    _arrfine.push("0");
                    _arrrevenueid.push(0);
                    _arrsemesterid.push(-1);
                }
                if (confirm(_alertmessage + "Do you want to submit for online transaction ?")) {
                    showProcessDialog("divprocess", true)
