            if (_flag) {
                if (_totalpayable != parseFloat($("#txtgivenamount").val()) + parseFloat($("#spnexcess").text())) {
                    alert("Amount(s) should be equal");
                    _flag = false;
                }
                
            }*/
            if (miscmount > 0)
