                        }
                    });
                    arrsembalance.push(sembalance);
                    arrsempaid.push(sempaid);
                });
                //console.log(arrsembalance);
                //console.log(arrsempaid);
                /*
                for (var sind = 0; sind < arrsembalance.length; sind++) {
                    if (_paidyearcheck) {
                        if (sind > 0) {
                            // console.log(arrsempaid[sind] + "," + arrsembalance[sind - 1] + "," + arrsempaid[sind - 1]);
                            if (arrsempaid[sind] > 0 && arrsembalance[sind - 1] > arrsempaid[sind - 1]) {
                                alert("Please pay previous semester dues");
                                _paidyearcheck = false;
                                return false;
                            }
                        }
                    }
                }
                if (!_paidyearcheck)
                    return false;
                */
                var _totalpayable = 0, _totalbalance = 0;
                var miscmount = 0;
                if ($("#chk_misc_fee").length > 0 && $("#chk_misc_fee").attr("checked"))
                    miscmount = $("#hdn_misc_fee").val();

                $("#divtabs").find("table").each(function () {
                    $(this).find("input:checkbox:checked").each(function () {

                        if (_flag) {
                            var _fineamount = 0, _fineconcession = 0;
                            if ($("#spnfine").text() != "") {
                                _fineamount = parseFloat($("#spnfine").text());
                            }

                            var _row = $(this).parent().parent();
                            var _txtamount = _row.find("input:text[name=txtamount]");
                            var _txtfine = _row.find("input:text[name=txtfine]");
                            var _feeamount = 0, _feefine = 0;
                            if (_txtamount.val() != '') {
                                _flag = checkNumeric(_txtamount, "amount", true);
                                _feeamount = _txtamount.val();
                                _totalpayable += parseFloat(_txtamount.val());
                            }
                            if (_txtfine.val() != '') {
                                if (parseFloat(_txtfine.val()) < 0) {
                                    alert("Invalid value");
                                    _flag = false;
                                    return false;
                                }
                                _feefine = _txtfine.val();
                            }

                            _totalbalance += parseFloat(_row.find("label[name=lblbalance]").attr("title")) + parseFloat(_feefine);


                            if (_flag) {
                                //if (_feeamount > 0 || _feefine > 0) {
                                if (_feeamount > 0) {
                                    _arrfeedueslno.push($(this).attr("name"));
                                    _arramount.push(_feeamount.toString());
                                    _arrfine.push(_feefine.toString());
                                    _arrrevenueid.push($(this).val());
                                    _arrsemesterid.push(_row.find("td:eq(3)").attr("name"));
                                    _arrencdata.push(_row.find("input:hidden[name=hdnencvalue]").val());
                                    _arrencfinedata.push(_row.find("input:hidden[name=hdnfineamount]").val());
                                    _arrencfinep.push(_row.find("input:hidden[name=hdnfinep]").val());
                                }
                                else {
                                    alert("Please pay fee amount");
                                    _flag = false;
                                    _txtamount.focus();
                                    return false;
                                }
                            }
                        }
                    });
                });
                if (_flag) {
                    if (_arrfeedueslno.length == 0 && miscmount == 0) {
