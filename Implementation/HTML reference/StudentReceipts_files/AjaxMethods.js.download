function fillCurrentExamHeldDetails(ddlid, divbranchid, defaulttext, fixstatus, regulationddlid,subjecodeddl,subject_type,fillbranchsections) {
    $("#" + ddlid).find("option:gt(0)").remove();
    fixstatus = (fixstatus == null || fixstatus == "" ? "-" : fixstatus);
    try {

        var response = AjaxGeneral.GetExamsHeldData(fixstatus);
        if (response.error == null) {
            if (response.value != "SE") {
                var jsonobject = JSON.parse(response.value);
                $.each(jsonobject, function (i, v) {
                    $("#" + ddlid).append("<option value='" + v.courseid + "' name='" + v.semesterid + "' title='" + v.examtype + "' id='" + v.heldserialno + "'>" + v.semestername + ", " + v.examname + "- " + v.monthyear + "</option>");
                })
		if ((divbranchid != null && divbranchid != "") || (regulationddlid != null && regulationddlid != "") || (subjecodeddl != null && subjecodeddl!="")) {
    $("#" + ddlid).change(function () {
        if (divbranchid != null && divbranchid != "")
            $("#" + divbranchid).html("<select id='ddlbranch'><option value='0'>" + (defaulttext == null ? "All" : defaulttext) + "</option></select>");
        if (regulationddlid != null && regulationddlid != "")
            $("#" + regulationddlid).find("option:gt(0)").remove();
        if ($("#" + ddlid).val() > 0) {
            if (divbranchid != null && divbranchid != "") {

                if ($("#" + ddlid).val() > 0) {
                    loadBranchesDropDown($("#" + ddlid), divbranchid, "ddlbranch", null, true);
                    if (defaulttext != null)
                        $("#ddlbranch option:eq(0)").text(defaulttext);
		    if ((subjecodeddl != null && subjecodeddl != "") || (fillbranchsections)) {
 			   $("#ddlbranch").change(function () {
			        if (subjecodeddl != null && subjecodeddl!="")
			           fillExamHeldSubjects(subjecodeddl, "ddlbranch", $("#" + ddlid + " option:selected").attr("id"), (subject_type == null ? "-" : subject_type));
			     if (fillbranchsections)
		            fillExamSections(ddlid, 'D', 'divsection');
		    	});
		   }
                }
            }
            if (regulationddlid != null && regulationddlid != "") {
                fillExamHeldRegulations(regulationddlid, $("#" + ddlid).find("option:selected").attr("id"));
            }
	    if (subjecodeddl != null && subjecodeddl != "")
	    {
		    fillExamHeldSubjects(subjecodeddl, "", $("#" + ddlid + " option:selected").attr("id"), "-");
	    }

        }
    });

}                

            }
            else Raiserror("SE");
        }
        else alert(response.error);
    }
    catch (e) {
        alert(e.error);
    }
}
function loadSemesterSubjects() {
    $("#ddlsubject option:gt(0)").remove();
    if ($("#ddlbranch").val() > 0 && $("#ddlsemester").val() >= 0) {
        try {
            var response = AjaxGeneral.ShowSubjects($("#ddlcourse").val(), $("#ddlbranch").val(), $("#ddlsemester").val());
            if (response.error == null) {
                $.each(JSON.parse(response.value), function (i, v) {
                    if (v.subjecttype != 'O')
                        $("#ddlsubject").append("<option value='" + v.subjectid + "'>" + v.subjectname +"-("+v.subjectcode + ")</option>");
                })
            }
            else console.log(response.error);
        }
        catch (e) {
            console.log(e.error);
        }
    }
}

function fillExamHeldSubjects(ddlsubid, ddlbranchid, heldslno, subtype) {
    $("#" + ddlsubid).find("option gt(0)").remove();
    let branchid = 0;
    if (ddlbranchid != null && ddlbranchid!="")
       branchid= $("#" + ddlbranchid).val();

    if (heldslno != null && heldslno > 0) {
        try {
            var response = AjaxGeneral.GetSubjectsByExamHeld(heldslno, branchid, subtype);
            if (response.error == null) {
                var jsonobject = JSON.parse(response.value);
                $.each(jsonobject, function (i, v) {
                    $("#" + ddlsubid).append("<option value='" + v.codeid + "'>" + v.subject_name + "(" + v.subject_code + ")</option>");
                });
            }
            else alert("Error while fill courses-" + response.error);
        }
        catch (e) {
            alert(e.error);
        }
    }
}

function fillStudentExamHeldDetails() {
    try {
        showProcessDialog("divprocess", true);
        setTimeout(function () {
            try {
                var response = AjaxGeneral.FillStudentExamHeldDetails();
                if (response.error == null) {
                    var jsonobject = JSON.parse(response.value);
                    $.each(jsonobject, function (i, v) {
                        $("#ddlsemester").append("<option value='" + v.semesterid + "' title='" + v.examtype + "' name='" + v.encdata + "'>" + v.semester + " " + v.examname + ", " + v.monthyear + "</option>");
                    });
                }
                else alert("Error while get exam held details:" + response.error);
            }
            catch (e) { alert(e.error); }
            finally {
                showProcessDialog("divprocess", false);
            }

        }, 500);
    }
    catch (e) {
        console.log(e.error);
    }
}

function fillExamSections(ddlheldid, sectiontypefill, divsectionid) {

    $("#" + divsectionid).html("No Section(s)");

    if ($("#ddlbranch").val() >= 0) {
        var selectedoption = $("#" + ddlheldid).find("option:selected");
        if (selectedoption.attr("title") == "R") {
            var brresponse = AjaxGeneral.GetSectionsByExam(selectedoption.attr("id"), $("#ddlbranch").val());
            if (brresponse.error == null) {
                var brjsonobject = JSON.parse(brresponse.value);
                var str = "";
                if (sectiontypefill == 'C')
                    str = "<table id='tblsections'><tr>";
                else str = "<select id='ddlsection'><option value='0'>Select</option>";

                $.each(brjsonobject, function (i, v) {
                    if (sectiontypefill == 'C')
                        str += "<td><input type='checkbox' value='" + v.sectionid + "'/>&nbsp;" + v.section + "</td><td>&nbsp;</td>";
                    else
                        str += "<option value='" + v.sectionid + "'>" + v.section + "</option>";
                });

                if (sectiontypefill == 'C')
                    str += "</tr></table>";
                else str += "</select>";

                $("#" + divsectionid).html(str);
            }
            else alert("Error while load exam sections");
        }
        else {
            var str1 = "";
            if (sectiontypefill == 'C')
                str1 = "<table id='tblsections'><tr><td><input type='checkbox' value='100' checked='checked'/>&nbsp;Supply</td></tr>";
            else str1 = "<select id='ddlsection'><option value='0'>Select</option><option value='100'>Supply</option></select>";
            $("#" + divsectionid).html(str1);
        }
    }

}


function fillSchedule_AjaxGeneral() {
	$("#ddlschedule option:gt(0)").remove();
    if ($("#ddlsemester option:selected").attr("name") >= 0) {
        try {

            var resp = AjaxGeneral.GetExamSchedules($("#ddlsemester").val(), $("#ddlsemester option:selected").attr("name"));
            if (resp.error == null) {

                var dt = JSON.parse(resp.value);
                var _item = '';
                //console.log(dt.length);
                if (!isEmpty(dt) && dt.length > 0) {
                    $.each(dt, function (i, item) {
                        _item += `<option id="${item.ExamDay}" name="${item.FExamDate}"  value="${item.SerialNo}"> ${item.FExamDate} - ${item.FromTime} - ${item.ToTime} ( ${item.regulation} )</option>`;

                    });
                }
                else
                    _item = '<option value="0">- no data -</option>';
                $("#ddlschedule").append(_item);

            }
            else
                alert(resp.error);


        }
        catch (ex) {

        }
    }
}

function fillRooms_AjaxGeneral() {

    if ($("#ddlschedule").val() > 0) {
        try {
            var resp = AjaxGeneral.GetSeatingPlanRooms($("#ddlschedule").val(), $("#ddlsemester option:selected").attr("name"));
            if (resp.error == null) {
                var dt = JSON.parse(resp.value);
                var _item = '';
                if (!isEmpty(dt) && dt.length > 0) {
                    $.each(dt, function (i, item) {
                        _item += `<option value='${item.roomid}'> ${item.Block + ' ' + item.RoomNo} </option>`;
                    });
                }
                else
                    _item = '<option value="0">- no data -</option>';

                $("#ddlroom").append(_item);
            }
            else
                alert(resp.error);

        }
        catch (ex) {
        }
    }
}


function fillSemesterExamHeldDetails(ctlsemid, ctlhelddataid, isall) {
  isall = (isall == null ? false : isall);
    var _ddl_held = $("#" + ctlhelddataid)
    _ddl_held.find("option:gt(0)").remove();
    var _held_sem_id = parseInt($("#" + ctlsemid).val());
    if (_held_sem_id >= 0) {
        try {
            var response = AjaxGeneral.GetExamsHeldDataBySemester(_held_sem_id,isall);
            if (response.error == null) {
                var jsonobject = JSON.parse(response.value);
                $.each(jsonobject, function (i, v) {
                    _ddl_held.append(`<option value="${v.heldserialno}" data-info="${v.heldmonth}|${v.heldyear}|${v.examtype}">${v.monthyear} ${v.examname}</option>`);
                })
            }
            else console.log(response.error);
        }
        catch (e) {
            console.log(e.error);
        }
    }
}



function callWebMethod(options) {

    if (options.showprocess == null || options.showprocess)
        showProcessDialog("divprocess", true);

    $.ajax({
        url: options.url,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        data: JSON.stringify(options.data || {}),

        beforeSend: function (xhr) {
            
            if (options.token)
                xhr.setRequestHeader("X-Auth-Token", options.token);
            else {
                if (window.AUTH_TOKEN) {
                    xhr.setRequestHeader("X-Auth-Token", window.AUTH_TOKEN);
                } else {
                    console.warn("Token missing");
                }
            }
        },

        success: function (res, status, xhr) {

            // 🔁 ALWAYS update token FIRST
            try {
                
                if (xhr && xhr.getResponseHeader) {
                    var newToken = xhr.getResponseHeader("X-New-Token");
                    if (newToken) {
                        window.AUTH_TOKEN = newToken;
                    }
                }
            } catch (e) {
                console.warn("Token update failed:", e);
            }

            // 👉 THEN call user logic
            try {
                if (options.success)
                    options.success(res.d);
            } catch (e) {
                console.error("User success error:", e);
                if (options.error)
                    options.error(e);
            }
        },

        error: function (xhr, status, error) {

            // 🔁 ALSO update token on error (VERY IMPORTANT)
            try {
                if (xhr && xhr.getResponseHeader) {
                    var newToken = xhr.getResponseHeader("X-New-Token");
                    if (newToken) {
                        window.AUTH_TOKEN = newToken;
                    }
                }
            } catch (e) {
                console.warn("Token update failed (error):", e);
            }

            try {
                var err = JSON.parse(xhr.responseText);
                alert(err.Message || "Error occurred");
            } catch (e) {
                alert(xhr.responseText);
            }

            if (options.error)
                options.error(xhr, status, error);
        },

        complete: function () {
            if (options.showprocess == null || options.showprocess)
                showProcessDialog("divprocess", false);

            ResizeIFrame();

            if (options.complete)
                options.complete();
        }
    });
}



function callWebMethod_Old(options) {
    //$("#loader").show();
    if (options.showprocess == null || options.showprocess) 
    showProcessDialog("divprocess", true);
    $.ajax({
        url: options.url,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        data: JSON.stringify(options.data || {}),
        
        beforeSend: function (xhr) {
            /*if (options.headers) {
                for (var key in options.headers) {
                    xhr.setRequestHeader(key, options.headers[key]);
                }
            }*/
            if (options.token!=null)
                xhr.setRequestHeader("X-Auth-Token", options.token);
        },
        

        

        success: function (res) {
            //if (options.success) options.success(res.d);

            try {
                if (options.success)
                    options.success(res.d);
            } catch (e) {
                console.error("Wrapper caught error:", e);

                if (options.error)
                    options.error(e);
            }
            finally {
                ResizeIFrame();
            }

        },

        error: function (xhr, status, error) {
            try {
                var err = JSON.parse(xhr.responseText);
                alert(err.Message || "Error occurred");
            } catch (e) {
                alert(xhr.responseText);
            }
        },
        complete: function () {
            // ✅ Global finally
	     if (options.showprocess == null || options.showprocess)
            showProcessDialog("divprocess", false);

            // ✅ Page-specific finally
            if (options.complete) {
                options.complete();
            }
        }

    });
}