{
    "manifest_version": 3,
    "name": "𝚁𝚎𝙴𝚌𝚊𝚙\"/",
    "version": "1.6.0",
    "description": "A modern reskin for the AEC student portal - cleaner UI, same functionality.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "64": "icons/icon64.png",
            "128": "icons/icon128.png"
        },
        "default_title": "𝚁𝚎𝙴𝚌𝚊𝚙\"/"
    },
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "*://info.aec.edu.in/*",
        "https://aria.lupixele.online/*",
        "https://fonts.googleapis.com/*",
        "https://fonts.gstatic.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://info.aec.edu.in/*"
            ],
            "js": [
                "shared/interceptor.js"
            ],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://info.aec.edu.in/*"
            ],
            "css": [
                "shared/tokens.css",
                "style.css"
            ],
            "js": [
                "shared/theme.js",
                "shared/aria.js",
                "content.js",
                "decorators.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "shared/interceptor.js",
                "shared/theme.js",
                "shared/aria.js",
                "shared/tokens.css",
                "style.css",
                "lib/jspdf.umd.min.js",
                "pdf_generator.js"
            ],
            "matches": [
                "*://info.aec.edu.in/*"
            ]
        }
    ]
}