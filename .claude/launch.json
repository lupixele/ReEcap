{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ReEcap HTTP Server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8443"],
      "port": 8443
    },
    {
      "name": "ReEcap Popup Preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["Implementation/preview/popup-preview-host.js"],
      "port": 8765,
      "url": "http://localhost:8765/"
    },
    {
      "name": "External Site Proxy",
      "runtimeExecutable": "python",
      "runtimeArgs": ["proxy.py"],
      "port": 8080
    }
  ]
}